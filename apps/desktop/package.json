{
  "name": "murmur-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle:linux-wayland": "TRANSCRIBE_CMAKE_ARGS=-DTRANSCRIBE_USE_SYSTEM_BLAS=OFF NO_STRIP=1 tauri build --bundles appimage --ci && bash scripts/repack-wayland-appimage.sh",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:keyboard": "node --experimental-strip-types src/lib/utils/keyboard.test.ts",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "check:translations": "node --experimental-strip-types scripts/check-translations.ts",
    "check:model-languages": "node --experimental-strip-types scripts/check-model-language-coverage.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-global-shortcut": "~2.4.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-sql": "~2.6.0",
    "@tauri-apps/plugin-store": "~2.5.1",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "i18next": "^27.1.2",
    "immer": "^11.2.10",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
